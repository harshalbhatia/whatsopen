<resources xmlns:tools="http://schemas.android.com/tools">
    <string name="app_name">WhatsOpen</string>

    <!-- By Number tab -->
    <!-- Main button on the By Number and Clipboard tabs: opens a WhatsApp chat with the number. -->
    <string name="open_in_whatsapp">Start Chat in WhatsApp</string>
    <!-- Label of the field for the international calling code, e.g. 44 for the United Kingdom.
         The field is narrow, so keep it short. -->
    <string name="country_code_hint">Country code</string>
    <!-- Shown before the digits in the country code field, as in "+44". Not a word. -->
    <string name="country_code_prefix" translatable="false">+</string>
    <!-- Label of the phone number field, next to the country code field. -->
    <string name="phone_number_hint">Number</string>
    <string name="subtitle">Open any WhatsApp chat without saving the contact</string>
    <!-- Below the phone number field. The field takes a number as dialled within the country chosen
         in the country code field, or a whole international number starting with "+" (or "00"),
         which then replaces the country code. -->
    <string name="phone_helper_text">Local number, or a full number starting with +</string>
    <!-- Next to the country code field: %1$s is the country's flag emoji, %2$s its name. -->
    <string name="country_label" translatable="false">%1$s  %2$s</string>
    <!-- Shown next to the country code field when no country uses the code typed in it. -->
    <string name="unknown_country_code">Unknown code</string>
    <!-- Button that reveals an optional message field on the By Number tab. -->
    <string name="add_message">Add a message</string>
    <!-- Label of the optional message field. -->
    <string name="message_hint">Message</string>
    <!-- Below the message field: WhatsApp opens with the message typed in, but the user still has to send it. -->
    <string name="message_helper_text">Typed in for you in WhatsApp, ready to send</string>
    <!-- Screen readers announce this for long-pressing the Start Chat button, as in
         "Double-tap and hold to reset WhatsApp app choice". -->
    <string name="reset_app_choice_action">Reset WhatsApp app choice</string>
    <!-- After long-pressing Start Chat: WhatsApp or WhatsApp Business will be asked for again next time. -->
    <string name="app_choice_reset">WhatsApp app choice reset</string>
    <!-- After long-pressing Start Chat when no app (WhatsApp or WhatsApp Business) had been remembered. -->
    <string name="app_choice_nothing_to_reset">No app choice to reset</string>

    <!-- Bottom navigation. Tab labels: keep them short, three sit side by side on a phone.
         Each is also the tab's name for screen readers, and By Number and Call Logs are their tab's
         title too. -->
    <!-- Tab for typing a phone number. -->
    <string name="nav_by_number">By Number</string>
    <!-- Tab listing the phone's recent calls. -->
    <string name="nav_call_logs">Call Logs</string>
    <!-- Tab for pasting text and finding the phone numbers in it. -->
    <string name="nav_clipboard">Clipboard</string>

    <!-- Clipboard tab -->
    <!-- Title of the Clipboard tab. -->
    <string name="clipboard_title">From Clipboard</string>
    <string name="clipboard_subtitle">Paste a phone number to start a WhatsApp chat</string>
    <!-- Label of the Clipboard tab's text box. -->
    <string name="clipboard_hint">Paste numbers here</string>
    <!-- Below the Clipboard tab's text box: the kind of text to paste. A number written the way
         people write numbers locally is fine; the hyphens are part of the number, not dashes. -->
    <string name="clipboard_helper_text" tools:ignore="TypographyDashes">Example: +1 555-123-4567</string>
    <!-- Card offering to paste the clipboard into the Clipboard tab's text box. -->
    <string name="clipboard_suggestion_title">Paste from clipboard</string>
    <!-- Card text when the clipboard holds text. The app doesn't look at the text until Paste is tapped. -->
    <string name="clipboard_suggestion_text">Your clipboard has text. Paste it to find the phone numbers in it.</string>
    <!-- Card text when Android has detected a phone number on the clipboard. -->
    <string name="clipboard_suggestion_text_phone">Your clipboard seems to have a phone number.</string>
    <!-- Button and icon that paste the clipboard's text into the text box. -->
    <string name="paste">Paste</string>
    <!-- Shown under the Clipboard tab's text box when the text in it has no phone number. -->
    <string name="no_phone_number_found">No phone number found</string>
    <!-- Above the phone numbers found in the Clipboard tab's text box. %d is how many. -->
    <plurals name="numbers_found">
        <item quantity="one">%d number found</item>
        <item quantity="other">%d numbers found</item>
    </plurals>

    <!-- Call Logs tab -->
    <string name="call_logs_subtitle">Open WhatsApp chat with your recent calls</string>
    <!-- Below the filter chips; read out by screen readers when it changes. %d is how many calls the list shows. -->
    <plurals name="call_logs_count">
        <item quantity="one">%d call</item>
        <item quantity="other">%d calls</item>
    </plurals>
    <!-- Read by screen readers for the loading indicator. -->
    <string name="call_logs_loading">Loading recent calls</string>

    <!-- Filter chips above the call list. Each one on narrows the list: Incoming and Missed by call
         type, Non-contacts to numbers not saved in contacts. -->
    <string name="filter_incoming">Incoming</string>
    <string name="filter_missed">Missed</string>
    <string name="filter_non_contacts">Non-contacts</string>

    <!-- Call log rows. The second line of a row is the call type, then the time, e.g. "Missed (3) · 2 hr. ago". -->
    <string name="call_log_type_incoming">Incoming</string>
    <string name="call_log_type_outgoing">Outgoing</string>
    <!-- Also used for rejected and blocked calls. -->
    <string name="call_log_type_missed">Missed</string>
    <!-- For a call type the app doesn't recognise. -->
    <string name="call_log_type_other">Call</string>
    <!-- %1$s is a call type above, %2$d how many calls in a row the line stands for (always 2 or more). -->
    <string name="call_log_type_count">%1$s (%2$d)</string>
    <!-- %1$s is the call type (with its count), %2$s when the call was, e.g. "2 hr. ago". -->
    <string name="call_log_details">%1$s · %2$s</string>

    <!-- Read by screen readers for a call log row. %1$s is the contact's name or the phone number,
         %2$s when the call was, e.g. "2 hr. ago". -->
    <string name="call_log_description_incoming">Incoming call from %1$s, %2$s</string>
    <string name="call_log_description_outgoing">Outgoing call to %1$s, %2$s</string>
    <!-- Also used for rejected and blocked calls. -->
    <string name="call_log_description_missed">Missed call from %1$s, %2$s</string>
    <!-- For a call type the app doesn't recognise, so it doesn't say which way the call went. -->
    <string name="call_log_description_other">Call with %1$s, %2$s</string>
    <!-- Added when a row stands for several calls in a row. %1$s is one of the sentences above,
         %2$d how many calls (always 2 or more). -->
    <plurals name="call_log_description_count">
        <item quantity="one">%1$s, %2$d call</item>
        <item quantity="other">%1$s, %2$d calls</item>
    </plurals>
    <!-- Screen readers announce this for tapping a call log row, as in "Double-tap to open WhatsApp chat". -->
    <string name="call_log_open_chat_action">Open WhatsApp chat</string>
    <!-- Read by screen readers for the ⋮ button on a call log row. %1$s is the contact's name or the phone number. -->
    <string name="call_log_more_options">More options for %1$s</string>

    <!-- Menu of a call log row's ⋮ button -->
    <!-- Opens the phone app with the number ready to dial. -->
    <string name="call_log_action_call">Call</string>
    <string name="call_log_action_copy_number">Copy number</string>
    <!-- Opens the contacts app to add the number to a new or existing contact. -->
    <string name="call_log_action_save_contact">Save to contacts</string>
    <string name="call_log_action_view_contact">View contact</string>
    <!-- Shown after Copy number, on Android versions that don't confirm copies themselves. -->
    <string name="number_copied">Number copied</string>
    <!-- Label of the copied number on the clipboard; some keyboards and clipboard managers show it. -->
    <string name="phone_number_clip_label">Phone number</string>
    <!-- Shown when no app on the phone can call, show or save a contact. -->
    <string name="error_no_app_for_action">No app can do this</string>

    <!-- Empty States -->
    <string name="empty_call_logs_title">No recent calls</string>
    <string name="empty_call_logs_description">Your recent calls will appear here</string>
    <string name="empty_filtered_call_logs_title">No matching calls</string>
    <string name="empty_filtered_call_logs_description">Try changing your filters to see more results</string>
    <!-- Button that turns every filter chip off. -->
    <string name="clear_filters">Clear filters</string>
    <!-- Before the app has asked for the call log permission. -->
    <string name="call_logs_permission_title">See your recent calls here</string>
    <string name="call_logs_permission_rationale">To show recent calls so you can message a caller on WhatsApp. Nothing leaves your phone.</string>
    <!-- Button that asks Android for the call log permission. -->
    <string name="call_logs_allow_access">Allow access</string>
    <!-- When the call log permission was denied and Android won't ask again. "Call logs" is the
         permission's name in Android's settings. -->
    <string name="call_logs_permission_blocked_title">Call log access is off</string>
    <string name="call_logs_permission_blocked_text">To show recent calls so you can message a caller on WhatsApp, allow Call logs in this app\'s permissions. Nothing leaves your phone.</string>
    <!-- Button that opens this app's page in Android's settings. -->
    <string name="open_settings">Open settings</string>
    <!-- On tablets and other devices without a phone line. -->
    <string name="call_logs_no_telephony_title">This device doesn\'t make phone calls</string>
    <string name="call_logs_no_telephony_text">To start a chat, type or paste a number in the other tabs.</string>
    <string name="call_logs_error_title">Couldn\'t load recent calls</string>
    <string name="call_logs_error_text">Something went wrong reading the call log.</string>
    <!-- Button that reads the call log again after an error. -->
    <string name="try_again">Try again</string>

    <!-- Validation Errors -->
    <string name="error_country_code_required">Enter a country code</string>
    <string name="error_phone_required">Enter a phone number</string>
    <string name="error_invalid_phone_number">Not a valid phone number</string>

    <!-- Opening WhatsApp -->
    <string name="error_whatsapp_not_installed">WhatsApp is not installed on your device</string>
    <string name="error_opening_whatsapp">Error opening WhatsApp</string>
    <!-- Title of the dialog that asks whether to use WhatsApp or WhatsApp Business, which are
         listed below it. -->
    <string name="choose_whatsapp_title">Open chat in</string>
    <!-- Checkbox in that dialog: skip the question next time. -->
    <string name="remember_my_choice">Remember my choice</string>
    <string name="whatsapp_app_name" translatable="false">WhatsApp</string>
    <string name="whatsapp_business_app_name" translatable="false">WhatsApp Business</string>
    <string name="error_link_without_number">That link doesn\'t contain a valid phone number</string>
    <!-- Shown when Paste & Open (shortcut or Quick Settings tile) or the Clipboard tab's Paste finds nothing on the clipboard. -->
    <string name="error_clipboard_empty">Clipboard is empty</string>

    <!-- Shown in the menu that appears when text is selected in another app (next to Copy and Share).
         Opens a WhatsApp chat with the phone number in the selected text. -->
    <string name="process_text_label">WhatsApp chat</string>

    <!-- Quick Settings tile: opens a WhatsApp chat with the phone number on the clipboard. Keep it short. -->
    <string name="tile_paste_and_open">Paste &amp; Open</string>

    <!-- Accessibility -->
    <!-- Read by screen readers for the country shown next to the country code field.
         %1$s is the country's name, e.g. "India". -->
    <string name="country_label_description">Country: %1$s</string>

    <!-- App shortcuts, shown when the app icon is long-pressed. The short labels also name a
         shortcut pinned to the home screen, so keep them to about 10 characters. -->
    <!-- Opens a WhatsApp chat with the phone number on the clipboard. -->
    <string name="shortcut_paste_short">Paste &amp; Open</string>
    <string name="shortcut_paste_long">Paste a number and open WhatsApp</string>
    <!-- Opens the app on the Call Logs tab; use the same words as that tab. -->
    <string name="shortcut_call_logs_short">Call Logs</string>
    <string name="shortcut_call_logs_long">Open recent calls</string>
</resources>
