<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Screen layout -->
    <dimen name="screen_padding">24dp</dimen>
    <!-- Widest a tab's content gets on tablets, foldables and in landscape; see Widget.WhatsOpen.ContentColumn
         and CallLogsFragment. -->
    <dimen name="content_max_width">600dp</dimen>

    <!-- Spacing -->
    <dimen name="spacing_title_subtitle">8dp</dimen>
    <dimen name="spacing_subtitle_content">32dp</dimen>
    <dimen name="spacing_between_inputs">16dp</dimen>
    <dimen name="spacing_input_button">24dp</dimen>

    <!-- Component sizes. Minimums only, so text never clips at large font sizes. -->
    <dimen name="button_min_height">56dp</dimen>
    <dimen name="country_code_field_width">136dp</dimen>

    <!-- Corner radii -->
    <dimen name="corner_radius_input">8dp</dimen>
    <dimen name="corner_radius_card">12dp</dimen>

    <!-- Filter chips -->
    <dimen name="spacing_subtitle_filters">16dp</dimen>
    <dimen name="spacing_filters_content">16dp</dimen>
    <dimen name="chip_spacing">8dp</dimen>

    <!-- Card layout -->
    <dimen name="card_padding">16dp</dimen>

    <!-- Two-line list rows (Call Logs). Minimums only, so text never clips at large font sizes. -->
    <dimen name="list_item_min_height">72dp</dimen>
    <dimen name="list_item_padding_vertical">8dp</dimen>
    <!-- Less than screen_padding: a trailing 48dp icon button's icon then lines up with the screen padding. -->
    <dimen name="list_item_padding_end">12dp</dimen>
    <dimen name="call_type_icon_size">16dp</dimen>
    <dimen name="call_type_icon_spacing">4dp</dimen>
    <dimen name="icon_button_size">48dp</dimen>
    <!-- Empty, loading and permission messages on the Call Logs tab -->
    <dimen name="message_padding_vertical">48dp</dimen>
    <dimen name="message_icon_size">64dp</dimen>

</resources>
