<?xml version="1.0" encoding="utf-8"?>
<!-- Shown below the Call Logs header instead of calls: loading, permission, nothing to show. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_padding"
    android:paddingTop="@dimen/message_padding_vertical"
    android:paddingEnd="@dimen/screen_padding"
    android:paddingBottom="@dimen/message_padding_vertical">

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/call_logs_loading"
        android:indeterminate="true"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/icon"
        android:layout_width="@dimen/message_icon_size"
        android:layout_height="@dimen/message_icon_size"
        android:alpha="0.5"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_call_log"
        app:tint="?android:textColorSecondary" />

    <TextView
        android:id="@+id/message_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_between_inputs"
        android:gravity="center"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        tools:text="@string/empty_call_logs_title" />

    <TextView
        android:id="@+id/message_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_title_subtitle"
        android:gravity="center"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?android:textColorSecondary"
        tools:text="@string/empty_call_logs_description" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/message_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_input_button"
        android:visibility="gone"
        tools:text="@string/call_logs_allow_access"
        tools:visibility="visible" />

</LinearLayout>
