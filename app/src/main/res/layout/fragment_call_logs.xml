<?xml version="1.0" encoding="utf-8"?>
<!-- One list for everything, so the title and filter chips scroll away with the calls:
     a header item, then the calls or a message (loading, permission, empty). It spans the
     window; CallLogsFragment pads its sides to keep the rows in a centred column. -->
<androidx.recyclerview.widget.RecyclerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/recycler_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingBottom="@dimen/screen_padding"
    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
    tools:context=".CallLogsFragment"
    tools:listitem="@layout/item_call_log" />
